[Unit]
Description=OpenClaw BriefingManager
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=gravesab
WorkingDirectory=/home/gravesab/ai/projects/openclaw/tools/briefing
Environment=OPENCLAW_DB_VIA_DOCKER=1
Environment=OPENCLAW_DB_CONTAINER=postgres
EnvironmentFile=-/home/gravesab/.config/openclaw/db.env
ExecStart=/home/gravesab/ai/projects/openclaw/tools/briefing/.venv/bin/python3 /home/gravesab/ai/projects/openclaw/tools/briefing/briefing_manager.py
StandardOutput=append:/home/gravesab/openclaw_briefing.log
StandardError=append:/home/gravesab/openclaw_briefing.log
